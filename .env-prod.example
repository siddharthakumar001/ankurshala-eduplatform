# =============================================================================
# Ankurshala Production Environment Configuration
# Copy this file to .env-prod on your VM and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
DB_NAME=ankurshala
DB_USERNAME=ankur
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Security Keys (CHANGE THESE IN PRODUCTION!)
# -----------------------------------------------------------------------------
# JWT secret - must be at least 64 characters for HS512
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_MUST_BE_AT_LEAST_64_CHARACTERS_LONG_CHANGE_THIS

# Bank encryption key - must be at least 32 characters for AES-256
BANK_ENC_KEY=YOUR_SECURE_BANK_ENCRYPTION_KEY_AT_LEAST_32_CHARS

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# For production, use real SMTP (SendGrid, AWS SES, etc.)
# For testing, keep mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ankurshala.com

# -----------------------------------------------------------------------------
# Frontend/API URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://ankurshala.com/api

# -----------------------------------------------------------------------------
# Demo/Seed Configuration
# -----------------------------------------------------------------------------
DEMO_SEED_ON_START=false
DEMO_ENV=prod
DEMO_FORCE=false

# -----------------------------------------------------------------------------
# AI Configuration (Optional - for AI Tutor feature)
# -----------------------------------------------------------------------------
AI_ENABLED=false

# OpenAI Configuration (choose one: OpenAI or Azure OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure OpenAI Configuration (alternative to OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002

# Azure Speech Configuration (for voice features)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_LANGUAGE=en-IN

# -----------------------------------------------------------------------------
# Image Tags (auto-updated by deploy script)
# -----------------------------------------------------------------------------
BACKEND_TAG=prod
FRONTEND_TAG=prod

