        log.info("");
        log.info("========================================");
        log.info("📋 E2E TEST CREDENTIALS");
        log.info("========================================");
        log.info("Admin:");
        log.info("  Email: {}", ADMIN_EMAIL);
        log.info("  Password: {}", E2E_PASSWORD);
        log.info("");
        log.info("Student 1:");
        log.info("  Email: {}", STUDENT1_EMAIL);
        log.info("  Password: {}", E2E_PASSWORD);
        log.info("");
        log.info("Student 2:");
        log.info("  Email: {}", STUDENT2_EMAIL);
        log.info("  Password: {}", E2E_PASSWORD);
        log.info("");
        log.info("Teacher 1:");
        log.info("  Email: {}", TEACHER1_EMAIL);
        log.info("  Password: {}", E2E_PASSWORD);
        log.info("");
        log.info("Teacher 2:");
        log.info("  Email: {}", TEACHER2_EMAIL);
        log.info("  Password: {}", E2E_PASSWORD);
        log.info("========================================");
        log.info("");
    }
}
